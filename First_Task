import matplotlib.pyplot as plt

# Age groups and corresponding population data (from the image)
age_groups = ['0 to 20 Years', '21 to 64 Years', '65+ Years']
population_millions = [512, 807, 98]  # in millions
percentages = [36.1, 57.0, 6.9]

# Bar chart
plt.figure(figsize=(10, 6))
bars = plt.bar(age_groups, population_millions, color=['yellow', 'blue', 'magenta'])

#Bar chart with the population and percentage
for bar, pop, pct in zip(bars, population_millions, percentages):
    yval = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, yval + 10, f'{pop} Mn\n({pct}%)',
             ha='center', va='bottom', fontsize=12)

# Labels and title
plt.xlabel("Age Groups")
plt.ylabel("Population (in Millions)")
plt.title("India's Population Distribution by Age in 2022")
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()

# Show the plot
plt.show()
